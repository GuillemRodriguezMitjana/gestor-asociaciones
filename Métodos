// Metodo 1: Mostrar les dades de la llista d'associacions
public void mostrarListaAsociaciones(ListaAsociaciones listaAsociaciones) {
    if (listaAsociaciones.getNElem() == 0) {
        System.out.println("No hay asociaciones registradas.");
        return;
    }
    System.out.println("Lista de Asociaciones:");
    System.out.println(listaAsociaciones);
}

// Metodo 7: Afegir una nova associació
public void agregarNuevaAsociacion(ListaAsociaciones listaAsociaciones) {
    Scanner scanner = new Scanner(System.in);

    System.out.print("Introduce el nombre de la nueva asociación: ");
    String nombre = scanner.nextLine();

    System.out.print("Introduce la fecha de fundación (dd/mm/yyyy): ");
    String fechaFundacion = scanner.nextLine();

    System.out.print("Introduce la descripción de la asociación: ");
    String descripcion = scanner.nextLine();

    Asociacion nuevaAsociacion = new Asociacion(nombre, fechaFundacion, descripcion);

    try {
        listaAsociaciones.agregarAsociacion(nuevaAsociacion);
        System.out.println("¡Asociación añadida con éxito!");
    } catch (ExcepcionListaAsociacionLlena e) {
        System.out.println("Error: " + e.getMessage());
    }
}

// Metodo 10: Afegir una nova demostració
public void agregarNuevaDemostracion(Asociacion asociacion) {
    Scanner scanner = new Scanner(System.in);

    System.out.println("Añadir nueva demostración para la asociación: " + asociacion.getName());

    System.out.print("Título de la demostración: ");
    String titulo = scanner.nextLine();

    System.out.print("Fecha de diseño de la demostración (dd/mm/yyyy): ");
    String fecha = scanner.nextLine();

    System.out.print("Coste de los materiales: ");
    double costoMateriales = scanner.nextDouble();

    scanner.nextLine(); // Consumir el salto de línea.

    System.out.print("¿Está activa? (true/false): ");
    boolean activa = scanner.nextBoolean();

    // Generar código único.
    String codigo = asociacion.getName().substring(0, 3).toUpperCase() + (asociacion.getAcciones().getNElem() + 100);

    Demostracion nuevaDemostracion = new Demostracion(codigo, titulo, null, fecha, costoMateriales);
    nuevaDemostracion.setActiva(activa);

    if (asociacion.getAcciones().agregarAccion(nuevaDemostracion)) {
        System.out.println("Demostración añadida con éxito: " + nuevaDemostracion);
    } else {
        System.out.println("Error: No se pudo añadir la demostración.");
    }
}

// Metodo 16: Mostrar les dades de les xerrades que fara una persona concreta
public void mostrarCharlasPorPersona(ListaAcciones listaAcciones, String aliasPersona) {
    boolean encontrado = false;

    System.out.println("Charlas impartidas por: " + aliasPersona);
    for (int i = 0; i < listaAcciones.getNElem(); i++) {
        Accion accion = listaAcciones.obtenerAccion(i);
        if (accion instanceof Charla) {
            Charla charla = (Charla) accion;
            if (charla.getImpartidor().getAlias().equalsIgnoreCase(aliasPersona)) {
                System.out.println(charla);
                encontrado = true;
            }
        }
    }

    if (!encontrado) {
        System.out.println("No se encontraron charlas impartidas por: " + aliasPersona);
    }
}

